{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "src/lib/**",
      "use": "@vercel/static"
    },
    {
      "src": "src/data/**",
      "use": "@vercel/static"
    },
    {
      "src": "docs/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/api/config",
      "dest": "/api/config.js"
    },
    {
      "src": "/api/public-company",
      "dest": "/api/public-company.js"
    },
    {
      "src": "/api/auth-profile",
      "dest": "/api/auth-profile.js"
    },
    {
      "src": "/api/admin",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/admins",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/change-admin-password",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/sync-participant-auth-user",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/save-admin-profile",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/set-participant-access",
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/participant",
      "dest": "/api/participant.js"
    },
    {
      "src": "/api/register-participant",
      "dest": "/api/participant.js"
    },
    {
      "src": "/api/complete-participant-password-change",
      "dest": "/api/participant.js"
    },
    {
      "src": "/api/save-predictions",
      "dest": "/api/participant.js"
    },
    {
      "src": "/api/results",
      "dest": "/api/results.js"
    },
    {
      "src": "/api/save-results",
      "dest": "/api/results.js"
    },
    {
      "src": "/api/save-ranking",
      "dest": "/api/results.js"
    },
    {
      "src": "/api/semifinalists-conference",
      "dest": "/api/results.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
