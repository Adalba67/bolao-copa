{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "src/lib/**",
      "use": "@vercel/static"
    },
    {
      "src": "src/data/**",
      "use": "@vercel/static"
    },
    {
      "src": "docs/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/api/config",
      "dest": "/api/config.js"
    },
    {
      "src": "/api/public-company",
      "dest": "/api/public-company.js"
    },
    {
      "src": "/api/auth-profile",
      "dest": "/api/auth-profile.js"
    },
    {
      "src": "/api/admins",
      "dest": "/api/admins.js"
    },
    {
      "src": "/api/change-admin-password",
      "dest": "/api/change-admin-password.js"
    },
    {
      "src": "/api/request-password-reset",
      "dest": "/api/request-password-reset.js"
    },
    {
      "src": "/api/reset-password",
      "dest": "/api/reset-password.js"
    },
    {
      "src": "/api/sync-participant-auth-user",
      "dest": "/api/sync-participant-auth-user.js"
    },
    {
      "src": "/api/register-participant",
      "dest": "/api/register-participant.js"
    },
    {
      "src": "/api/complete-participant-password-change",
      "dest": "/api/complete-participant-password-change.js"
    },
    {
      "src": "/api/save-predictions",
      "dest": "/api/save-predictions.js"
    },
    {
      "src": "/api/save-results",
      "dest": "/api/save-results.js"
    },
    {
      "src": "/api/save-ranking",
      "dest": "/api/save-ranking.js"
    },
    {
      "src": "/api/save-admin-profile",
      "dest": "/api/save-admin-profile.js"
    },
    {
      "src": "/api/semifinalists-conference",
      "dest": "/api/semifinalists-conference.js"
    },
    {
      "src": "/api/set-participant-access",
      "dest": "/api/set-participant-access.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
